{
  "name": "traintrack-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen:api": "uv run --project .. ../src/api_schema.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "bench": "node scripts/bench-map.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@tanstack/react-query": "^5.108.2",
    "cheap-ruler": "^4.1.1",
    "cmdk": "^1.1.1",
    "maplibre-gl": "^6.19.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
