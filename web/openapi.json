{
  "openapi": "3.1.0",
  "info": {
    "title": "TrainTrack",
    "version": "0.7.0"
  },
  "paths": {
    "/api/positions": {
      "get": {
        "summary": "Positions",
        "description": "Every placed train at the latest tick, or at `at` (an ISO time) to look at another moment. A page replaying\nthe past asks again every few seconds with a later `at`; `clock` in the reply is then `replay:<at>`.",
        "operationId": "positions_api_positions_get",
        "parameters": [
          {
            "name": "at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "At"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trains/{rid}": {
      "get": {
        "summary": "Train",
        "description": "One train's stops, times, route and position.",
        "operationId": "train_api_trains__rid__get",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stream": {
      "get": {
        "summary": "Stream",
        "description": "Positions as server-sent events, one per tick. A `snapshot` event holds every train (as /api/positions);\na `changes` event holds only new and changed trains and the rids removed. Pass the version you already have\nas `since` (or let the browser send Last-Event-ID on reconnect) to start with changes instead of a snapshot.",
        "operationId": "stream_api_stream_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/segments": {
      "get": {
        "summary": "Segments",
        "description": "Track paths between pairs of TIPLOCs, written `FROM>TO`, as (lon, lat) points: the lines trains move along\nbetween their `from_tiploc` and `to_tiploc`. Pairs that can't be placed are left out.",
        "operationId": "segments_api_segments_get",
        "parameters": [
          {
            "name": "pairs",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "Pairs"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "title": "Response Segments Api Segments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "summary": "Stations",
        "description": "Every station trains call at, by CRS code, for search.",
        "operationId": "stations_api_stations_get",
