# Provided by NationalRail
KAFKA_SERVER=darwin-broker:9092
KAFKA_USERNAME=your-provided-username
KAFKA_PASSWORD=your-provided-password
KAFKA_GROUP=chosen-darwin-group
KAFKA_TOPIC=prod-1010-Darwin-Train-Information-Push-Port-IIII2_0-JSON

# Provided by Network Rail (Train Describer, on the Rail Data Marketplace)
TD_KAFKA_SERVER=pkc-z3p1v0.europe-west2.gcp.confluent.cloud:9092
TD_KAFKA_USERNAME=your-provided-username
TD_KAFKA_PASSWORD=your-provided-password
TD_KAFKA_GROUP=your-provided-group
TD_KAFKA_TOPIC=TD_ALL_SIG_AREA

# Your database config
POSTGRES_USER=postgres
POSTGRES_PASS=your-secret-password
POSTGRES_DB=nationalrail
DATABASE_URL=postgresql://postgres:your-secret-password@localhost:5432/nationalrail

# Optional
# DATA_DIR=data          # where the timetable files land
# LOG_LEVEL=INFO         # DEBUG shows every unmatched location
# TEST_DATABASE_URL=     # a throwaway database for `uv run pytest` (it gets wiped)
# EVENTS_KEEP_DAYS=14    # days of raw events kept in Postgres; older days are archived to ARCHIVE_DIR
# FRAMES_KEEP_DAYS=0     # days of recorded map frames kept; 0 keeps them forever
# ARCHIVE_DIR=data/archive
